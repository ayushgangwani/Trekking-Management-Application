# Do not upload secrets and local configuration
.env
.env.*
!.env.example

# Do not upload Python environments and generated files
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]

# Do not upload local databases, Celery schedules, or generated exports
backend/instance/
backend/*.db
backend/*.sqlite
backend/*.sqlite3
backend/celerybeat-schedule.*
backend/exports/

# Do not upload frontend dependencies or build output
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/coverage/
*.local
*.tsbuildinfo

# Do not upload logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Do not upload editor and operating-system files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.eslintcache
.DS_Store
Thumbs.db

# Do not upload test artifacts
cypress/videos/
cypress/screenshots/
__screenshots__/
